# Neon Postgres (added automatically when you install Neon from the Vercel Marketplace)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Resend (added automatically by the Resend Marketplace integration as RESEND_API_KEY)
RESEND_API_KEY=
# The sender for login links and invites. The domain must be verified in Resend.
AUTH_EMAIL_FROM="Block Ten Strategy <hello@blocktenstrategy.com>"

# Comma-separated emails that get the admin dashboard and can always sign in
ADMIN_EMAILS=hello@blocktenstrategy.com

# Vercel AI Gateway. Not needed on Vercel itself (it signs in automatically); needed for local dev.
AI_GATEWAY_API_KEY=
# Any Claude model id that AI Gateway offers
AI_MODEL=anthropic/claude-sonnet-5-5
# How many times each client can run their framework in total (admins are unlimited)
MAX_RUNS=3

# The public address of the app, used in invite emails
APP_URL=https://app.blocktenstrategy.com
